# Classic Bluetooth (BR/EDR) + SPP, matching the bt_spp_acceptor example.
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y

# Controller mode: Classic BT only (no BLE/Dual-mode).
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLE_ENABLED=n

# The board's flash is 4MB; the default 2MB header prevents the BT controller
# firmware from loading and hangs the controller at BTDM_INIT.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
